# Overwolf Dev Mode credentials for `npm run dev:ow` (game events test).
# Copy this file to .env.overwolf.local (git-ignored) and fill in ONE of the two options.
# Both come from the Overwolf Developers Console (Console > Profile > API Keys).

# Option 1: your Overwolf Console email and an API key
OW_CLI_EMAIL=
OW_CLI_API_KEY=

# Option 2: a dev token instead of the two above
# OW_DEV_KEY=
